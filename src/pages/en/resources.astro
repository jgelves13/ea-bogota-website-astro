---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout locale="en" title="Resources" currentPage="resources">
<section class="ae-section page-top">
<div class="container">
  <span class="ae-eyebrow">Resources</span>
  <h1 class="page-title-ed">
    Readings, essays, and tools <span class="ae-em">for impact</span>.
  </h1>
  <p class="ae-subhead" style="margin-top: 16px;">
    Videos, books, podcasts, career guides, giving platforms, and funding opportunities.
  </p>
</div>
</section>

