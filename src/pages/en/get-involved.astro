---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout locale="en" title="Take Action" currentPage="get-involved">
<section class="ae-section page-top">
<div class="container">
  <span class="ae-eyebrow">Get involved</span>
  <h1 class="page-title">
    Take <span class="ae-em">action</span>.
  </h1>
  <p class="ae-subhead" style="margin-top: 24px;">
    There are many ways to make a difference. These resources will help you find the one that best fits you.
  </p>
</div>
</section>

<!-- 1. Contribute your time -->
<section class="ae-section" id="contribute-time" style="border-top: 1px solid var(--ae-rule-strong);">
<div class="container">
  <span class="ae-eyebrow ae-eyebrow--mute">I. Your time</span>
  <h2 class="section-title-ed">
    Contribute your <span class="ae-em">time</span>
  </h2>
  <p style="color: var(--ae-ink-soft); max-width: 560px; margin-bottom: 40px;">
    Find a high-impact job, volunteering, or opportunity.
  </p>

  <div class="grid grid-3 fade-in">
    <a href="/en/opportunities/" class="action-card">
      <div class="action-card-img-wrap"><img class="action-card-img" src="/img/take-action/find-volunteering.jpg" alt="" loading="lazy"></div>
      <div class="action-card-body">
        <h4>Browse opportunities</h4>
        <p>Jobs, volunteer roles, and projects with a special focus on Colombia and Latin America, at organizations that prioritize evidence.</p>
        <span class="action-card-arrow">View opportunities</span>
      </div>
    </a>

    <a href="https://80000hours.org/career-guide/" target="_blank" rel="noopener noreferrer" class="action-card">
      <div class="action-card-img-wrap"><img class="action-card-img" src="/img/take-action/career-guide.jpg" alt="" loading="lazy"></div>
      <div class="action-card-body">
        <h4>80,000 Hours career guide</h4>
        <p>A free guide backed by more than ten years of research on high-impact careers.</p>
        <span class="action-card-arrow">Read the guide</span>
      </div>
    </a>

    <a href="https://probablygood.org/advising/" target="_blank" rel="noopener noreferrer" class="action-card">
      <div class="action-card-img-wrap"><img class="action-card-img" src="/img/take-action/career-advising.jpg" alt="" loading="lazy"></div>
      <div class="action-card-body">
        <h4>1:1 advising with Probably Good</h4>
        <p>Get free, personalized career advising, also available in Spanish.</p>
        <span class="action-card-arrow">Get advising</span>
      </div>
    </a>

    <a href="https://jobs.80000hours.org/" target="_blank" rel="noopener noreferrer" class="action-card">
      <div class="action-card-img-wrap"><img class="action-card-img" src="/img/take-action/high-impact-job.jpg" alt="" loading="lazy"></div>
      <div class="action-card-body">
        <h4>80,000 Hours job board</h4>
        <p>Browse carefully selected openings at high-impact organizations worldwide.</p>
        <span class="action-card-arrow">View jobs</span>
      </div>
    </a>

    <a href="/en/team/#join" class="action-card">
      <div class="action-card-img-wrap"><img class="action-card-img" src="/img/take-action/talent-database.jpg" alt="" loading="lazy"></div>
      <div class="action-card-body">
        <h4>Volunteer with EA Bogota</h4>
        <p>Help organize events, create content, or develop partnerships with other organizations.</p>
        <span class="action-card-arrow">Volunteer</span>
      </div>
    </a>

    <a href="https://www.effectivealtruism.org/get-involved/newsletter" target="_blank" rel="noopener noreferrer" class="action-card">
      <div class="action-card-img-wrap"><img class="action-card-img" src="/img/take-action/best-of-forum.jpg" alt="" loading="lazy"></div>
      <div class="action-card-body">
        <h4>EA Newsletter</h4>
        <p>Join 60,000+ subscribers who get the latest EA ideas and opportunities each month.</p>
        <span class="action-card-arrow">Subscribe</span>
      </div>
    </a>
  </div>
</div>
</section>

<!-- 2. Give effectively -->
<hr class="ae-rule" />
<section class="ae-section" id="give">
<div class="container">
  <span class="ae-eyebrow ae-eyebrow--mute">II. Your donations</span>
  <h2 class="section-title-ed">
    Give to outstanding <span class="ae-em">charities</span>
  </h2>
  <p style="color: var(--ae-ink-soft); max-width: 560px; margin-bottom: 40px;">
    Strategic donations can do 10 to 100 times more good when directed to the most effective organizations.
  </p>

  <div class="grid grid-3 fade-in">
    <a href="https://www.givingwhatwecan.org/best-charities-to-donate-to-2025" target="_blank" rel="noopener noreferrer" class="action-card">
      <div class="action-card-img-wrap"><img class="action-card-img" src="/img/take-action/best-charities-2025.webp" alt="" loading="lazy"></div>
      <div class="action-card-body">
        <h4>Best charities 2025</h4>
        <p>Donate to a variety of effective projects and funds via Giving What We Can.</p>
        <span class="action-card-arrow">View charities</span>
      </div>
    </a>

    <a href="https://www.givewell.org/" target="_blank" rel="noopener noreferrer" class="action-card">
      <div class="action-card-img-wrap"><img class="action-card-img" src="/img/take-action/global-health-charities.jpeg" alt="" loading="lazy"></div>
      <div class="action-card-body">
        <h4>Global health with GiveWell</h4>
        <p>Extensively vetted charities that save and improve lives cost-effectively.</p>
        <span class="action-card-arrow">Visit GiveWell</span>
      </div>
    </a>

    <a href="https://farmkind.giving/" target="_blank" rel="noopener noreferrer" class="action-card">
      <div class="action-card-img-wrap"><img class="action-card-img" src="/img/take-action/animal-welfare.jpg" alt="" loading="lazy"></div>
      <div class="action-card-body">
        <h4>Animal welfare with FarmKind</h4>
        <p>Support rigorously assessed animal welfare charities through FarmKind.</p>
        <span class="action-card-arrow">Visit FarmKind</span>
      </div>
    </a>

    <a href="https://www.givingwhatwecan.org/pledge" target="_blank" rel="noopener noreferrer" class="action-card">
      <div class="action-card-img-wrap"><img class="action-card-img" src="/img/take-action/pledge-to-donate.jpg" alt="" loading="lazy"></div>
      <div class="action-card-body">
        <h4>The 10% Pledge</h4>
        <p>Join thousands who have pledged to donate 10% of their income through Giving What We Can.</p>
        <span class="action-card-arrow">Take the pledge</span>
      </div>
    </a>

    <a href="https://funds.effectivealtruism.org/" target="_blank" rel="noopener noreferrer" class="action-card">
      <div class="action-card-img-wrap"><img class="action-card-img" src="/img/take-action/ea-funds.jpg" alt="" loading="lazy"></div>
      <div class="action-card-body">
        <h4>EA Funds</h4>
        <p>Donate to expert-led funds to maximize the effectiveness of your charitable giving.</p>
        <span class="action-card-arrow">Visit EA Funds</span>
      </div>
    </a>

    <a href="/en/resources/#giving" class="action-card">
      <div class="action-card-img-wrap"><img class="action-card-img" src="/img/take-action/ea-forum-giving.jpeg" alt="" loading="lazy"></div>
      <div class="action-card-body">
        <h4>More giving resources</h4>
        <p>Additional guides and tools on how to give effectively.</p>
        <span class="action-card-arrow">View resources</span>
      </div>
    </a>
  </div>
</div>
</section>

<!-- 3. Connect with others -->
<hr class="ae-rule" />
<section class="ae-section" id="connect">
<div class="container">
  <span class="ae-eyebrow ae-eyebrow--mute">III. Your network</span>
  <h2 class="section-title-ed">
    Connect with <span class="ae-em">others</span>
  </h2>
  <p style="color: var(--ae-ink-soft); max-width: 560px; margin-bottom: 40px;">
    Connect with others committed to effective ways of helping others.
  </p>

  <div class="grid grid-3 fade-in">
    <a href="https://forum.effectivealtruism.org/" target="_blank" rel="noopener noreferrer" class="action-card">
      <div class="action-card-img-wrap"><img class="action-card-img" src="/img/take-action/ea-forum.png" alt="" loading="lazy"></div>
      <div class="action-card-body">
        <h4>EA Forum</h4>
        <p>The central place for collaborative discussion about how to do the most good.</p>
        <span class="action-card-arrow">Visit the forum</span>
      </div>
    </a>

    <a href="https://www.effectivealtruism.org/groups" target="_blank" rel="noopener noreferrer" class="action-card">
      <div class="action-card-img-wrap"><img class="action-card-img" src="/img/take-action/local-group.jpg" alt="" loading="lazy"></div>
      <div class="action-card-body">
        <h4>Find a local group</h4>
        <p>Join a group based on your location, interests, or professional affiliation.</p>
        <span class="action-card-arrow">Find groups</span>
      </div>
    </a>

    <a href="https://www.effectivealtruism.org/ea-global" target="_blank" rel="noopener noreferrer" class="action-card">
      <div class="action-card-img-wrap"><img class="action-card-img" src="/img/take-action/conference.jpg" alt="" loading="lazy"></div>
      <div class="action-card-body">
        <h4>EA Global &amp; EAGx</h4>
        <p>Attend the international Effective Altruism conferences, with events around the world.</p>
        <span class="action-card-arrow">View conferences</span>
      </div>
    </a>

    <a href="/en/events/" class="action-card">
      <div class="action-card-img-wrap"><img class="action-card-img" src="/img/take-action/local-event.jpeg" alt="" loading="lazy"></div>
      <div class="action-card-body">
        <h4>Events in Bogota</h4>
        <p>Talks, workshops, reading groups, and social meetups in Bogota. Open to everyone.</p>
        <span class="action-card-arrow">View events</span>
      </div>
    </a>

    <a href="https://www.magnifymentoring.org/" target="_blank" rel="noopener noreferrer" class="action-card">
      <div class="action-card-img-wrap"><img class="action-card-img" src="/img/take-action/magnify-mentoring.jpg" alt="" loading="lazy"></div>
      <div class="action-card-body">
        <h4>Magnify Mentoring</h4>
        <p>Get guidance from experienced professionals at high-impact organizations.</p>
        <span class="action-card-arrow">Visit Magnify</span>
      </div>
    </a>

    <a href="/en/team/" class="action-card">
      <div class="action-card-img-wrap"><img class="action-card-img" src="/img/take-action/start-ea-group.jpeg" alt="" loading="lazy"></div>
      <div class="action-card-body">
        <h4>Meet the team</h4>
        <p>Meet the people behind Effective Altruism Bogota. Reach out to anyone on the team for a conversation.</p>
        <span class="action-card-arrow">View the team</span>
      </div>
    </a>
  </div>
</div>
</section>

<!-- 4. Start something new -->
<hr class="ae-rule" />
<section class="ae-section" id="start">
<div class="container">
  <span class="ae-eyebrow ae-eyebrow--mute">IV. Your project</span>
  <h2 class="section-title-ed">
    Start something <span class="ae-em">new</span>
  </h2>
  <p style="color: var(--ae-ink-soft); max-width: 560px; margin-bottom: 40px;">
    Start your own high-impact organization, seek funding for a project, or start a group.
  </p>

  <div class="grid grid-3 fade-in">
    <a href="https://www.charityentrepreneurship.com/" target="_blank" rel="noopener noreferrer" class="action-card">
      <div class="action-card-img-wrap"><img class="action-card-img" src="/img/take-action/charity-entrepreneurship.jpg" alt="" loading="lazy"></div>
      <div class="action-card-body">
        <h4>Start a high-impact charity</h4>
        <p>AIM (Charity Entrepreneurship) offers incubation programs to found cost-effective organizations.</p>
        <span class="action-card-arrow">Visit AIM</span>
      </div>
    </a>

    <a href="https://tally.so/r/NpJlYN" target="_blank" rel="noopener noreferrer" class="action-card">
      <div class="action-card-img-wrap"><img class="action-card-img" src="/img/take-action/start-ea-group.jpeg" alt="" loading="lazy"></div>
      <div class="action-card-body">
        <h4>Start a university group</h4>
        <p>We offer mentorship, resources, and materials to start an EA group at your university in Bogota.</p>
        <span class="action-card-arrow">Get in touch</span>
      </div>
    </a>

    <a href="https://funds.effectivealtruism.org/" target="_blank" rel="noopener noreferrer" class="action-card">
      <div class="action-card-img-wrap"><img class="action-card-img" src="/img/take-action/ea-funds.jpg" alt="" loading="lazy"></div>
      <div class="action-card-body">
        <h4>Seek funding for a project</h4>
        <p>Explore EA Funds and other sources of funding for high-impact projects.</p>
        <span class="action-card-arrow">View opportunities</span>
      </div>
    </a>
  </div>
</div>
</section>

<!-- 5. Learn more -->
<hr class="ae-rule" />
<section class="ae-section" id="learn">
<div class="container">
  <span class="ae-eyebrow ae-eyebrow--mute">V. Your knowledge</span>
  <h2 class="section-title-ed">
    Learn <span class="ae-em">more</span>
  </h2>
  <p style="color: var(--ae-ink-soft); max-width: 560px; margin-bottom: 40px;">
    Learn more about cause areas and decide what matters to you.
  </p>

  <div class="grid grid-3 fade-in">
    <a href="/en/about-ea/" class="action-card">
      <div class="action-card-img-wrap"><img class="action-card-img" src="/img/take-action/intro-to-ea.jpg" alt="" loading="lazy"></div>
      <div class="action-card-body">
        <h4>What is Effective Altruism?</h4>
        <p>An introduction to Effective Altruism, its history, and why it needs to exist.</p>
        <span class="action-card-arrow">Learn more</span>
      </div>
    </a>

    <a href="https://www.effectivealtruism.org/virtual-programs/introductory-program" target="_blank" rel="noopener noreferrer" class="action-card">
      <div class="action-card-img-wrap"><img class="action-card-img" src="/img/take-action/intro-course.jpg" alt="" loading="lazy"></div>
      <div class="action-card-body">
        <h4>Introductory virtual program</h4>
        <p>Free 8-week course with 3.5 hours per week to dive deep into Effective Altruism.</p>
        <span class="action-card-arrow">Enroll</span>
      </div>
    </a>

    <a href="https://forum.effectivealtruism.org/handbook" target="_blank" rel="noopener noreferrer" class="action-card">
      <div class="action-card-img-wrap"><img class="action-card-img" src="/img/take-action/ea-handbook.jpg" alt="" loading="lazy"></div>
      <div class="action-card-body">
        <h4>EA Handbook</h4>
        <p>A selection of the best writing about Effective Altruism, organized as a handbook.</p>
        <span class="action-card-arrow">Read the handbook</span>
      </div>
    </a>

    <a href="/en/resources/#reading" class="action-card">
      <div class="action-card-img-wrap"><img class="action-card-img" src="/img/take-action/books-podcasts.jpg" alt="" loading="lazy"></div>
      <div class="action-card-body">
        <h4>Books and reading</h4>
        <p>Curated reading on Effective Altruism, giving, and cause areas.</p>
        <span class="action-card-arrow">View reading list</span>
      </div>
    </a>

    <a href="/en/resources/#careers" class="action-card">
      <div class="action-card-img-wrap"><img class="action-card-img" src="/img/take-action/career-guide.jpg" alt="" loading="lazy"></div>
      <div class="action-card-body">
        <h4>High-impact careers</h4>
        <p>Resources for building a purposeful, high-impact career.</p>
        <span class="action-card-arrow">View resources</span>
      </div>
    </a>

    <a href="https://probablygood.org/cause-areas/" target="_blank" rel="noopener noreferrer" class="action-card">
      <div class="action-card-img-wrap"><img class="action-card-img" src="/img/take-action/find-cause.jpg" alt="" loading="lazy"></div>
      <div class="action-card-body">
        <h4>Find a cause</h4>
        <p>Decide which causes to work on with help from Probably Good.</p>
        <span class="action-card-arrow">Explore causes</span>
      </div>
    </a>
  </div>
</div>
</section>

</BaseLayout>

<style>
  .page-top { padding-top: calc(var(--nav-height, 76px) + 48px); }
  .page-title {
    font-family: "Inter", system-ui, sans-serif;
    font-size: var(--ae-t-h1); font-weight: 600;
    line-height: 1.05; letter-spacing: var(--ae-h-tracking);
    max-width: 900px; text-wrap: balance; margin: 0;
  }
  .section-title-ed {
    font-family: "Inter", system-ui, sans-serif;
    font-size: var(--ae-t-h2); font-weight: 600;
    line-height: 1.10; letter-spacing: var(--ae-h-tracking);
    max-width: 900px; text-wrap: balance; margin: 0 0 8px;
  }
</style>
