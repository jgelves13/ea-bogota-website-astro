<BaseLayout locale="es" title="Equipo" currentPage="team">
<section class="ae-section page-top">
<div class="container">
  <span class="ae-eyebrow">Equipo</span>
  <h1 class="page-title-ed">
    Las personas detras de <span class="ae-em">AE Bogota</span>.
  </h1>
  <p class="ae-subhead" style="margin-top: 16px;">
    Profesionales comprometidos con usar evidencia y razon para hacer el mayor bien posible.
  </p>
</div>
</section>

