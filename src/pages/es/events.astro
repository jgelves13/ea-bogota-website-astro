---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/events.css';
import eventsData from '../../data/events.json';
const eventsJson = JSON.stringify(eventsData);
---

<BaseLayout locale="es" title="Eventos" currentPage="events">
<section class="ae-section page-top">
<div class="container">
  <span class="ae-eyebrow">Proximos eventos</span>
  <h1 class="page-title">
    Encuentros, lecturas y conversaciones <span class="ae-em">en Bogota</span>.
  </h1>
</div>
</section>

<!-- Upcoming Events Grid -->
<section class="ae-section" style="padding-top: 0;">
<div class="container">
  <hr class="ae-rule--bold" />
  <div style="padding-top: 32px;">
    <span class="ae-caption">Agenda</span>
    <div id="events-grid" class="events-grid fade-in" style="margin-top: 24px;"></div>
  </div>
</div>
</section>

<!-- Event Types -->
<section class="ae-section" style="background: var(--ae-paper); border-top: 1px solid var(--ae-rule-strong);">
<div class="container">
  <span class="ae-eyebrow ae-eyebrow--mute">Tipos de eventos</span>
  <h2 class="section-title-ed">
    Que tipo de eventos <span class="ae-em">organizamos</span>?
  </h2>

  <div class="ae-index" style="margin-top: 40px;">
    <div class="ae-index__row">
      <div class="ae-index__head">
        <span class="ae-index__num">I.</span>
        <h4 class="ae-index__title">Charlas</h4>
      </div>
      <p class="ae-index__body">Invitamos a expertos y profesionales a compartir su conocimiento sobre areas de causa, carreras de impacto, evaluacion de programas y mas. Sesiones de 60-90 minutos con espacio para preguntas.</p>
    </div>
    <div class="ae-index__row">
      <div class="ae-index__head">
        <span class="ae-index__num">II.</span>
        <h4 class="ae-index__title">Grupos de lectura</h4>
      </div>
      <p class="ae-index__body">Discusiones sobre libros y articulos clave del AE. Desde "Doing Good Better" hasta papers sobre evaluacion de impacto. Formato accesible para principiantes y expertos.</p>
    </div>
    <div class="ae-index__row">
      <div class="ae-index__head">
        <span class="ae-index__num">III.</span>
        <h4 class="ae-index__title">Talleres</h4>
      </div>
      <p class="ae-index__body">Sesiones interactivas donde los participantes aplican herramientas de AE a sus propias decisiones: planificacion de carrera, evaluacion de donaciones, teoria del cambio, y mas.</p>
    </div>
    <div class="ae-index__row">
      <div class="ae-index__head">
        <span class="ae-index__num">IV.</span>
        <h4 class="ae-index__title">Encuentros sociales</h4>
      </div>
      <p class="ae-index__body">Espacios informales para conocer a otros miembros de la comunidad, compartir ideas y construir conexiones. Porque el impacto tambien se construye en comunidad.</p>
    </div>
  </div>
</div>
</section>

<!-- Host an Event CTA -->
<section class="ae-section" style="border-top: 2px solid var(--ae-rule-bold);">
<div class="container" style="text-align: center; max-width: 640px;">
  <h2 class="section-title-ed" style="text-align: center;">
    Quieres organizar <span class="ae-em">un evento</span>?
  </h2>
  <p style="color: var(--ae-ink-soft); margin-bottom: 32px;">
    Si tienes una idea para una charla, taller o actividad relacionada con el AE, nos encantaria escucharla.
  </p>
  <a href="https://tally.so/r/J9J1aY" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
    Propon un evento
  </a>
</div>
</section>

<script is:inline define:vars={{ eventsJson }}>
  window.EVENTS_DATA = JSON.parse(eventsJson);
</script>
<script src="../../scripts/events.js"></script>
</BaseLayout>

<style>
  .container { max-width: 1280px; margin: 0 auto; padding: 0 24px; }
  @media (min-width: 768px) { .container { padding: 0 64px; } }
  .page-top { padding-top: calc(var(--nav-height, 76px) + 48px); }
  .page-title {
    font-family: "Inter", system-ui, sans-serif;
    font-size: var(--ae-t-h1); font-weight: 600;
    line-height: 1.05; letter-spacing: var(--ae-h-tracking);
    max-width: 900px; text-wrap: balance; margin: 0;
  }
  .section-title-ed {
    font-family: "Inter", system-ui, sans-serif;
    font-size: var(--ae-t-h1); font-weight: 600;
    line-height: 1.05; letter-spacing: var(--ae-h-tracking);
    max-width: 900px; text-wrap: balance; margin: 0 0 16px;
  }
</style>
