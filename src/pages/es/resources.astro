---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout locale="es" title="Recursos" currentPage="resources">
<section class="ae-section page-top">
<div class="container">
  <span class="ae-eyebrow">Recursos</span>
  <h1 class="page-title-ed">
    Lecturas, ensayos y herramientas <span class="ae-em">en espanol</span>.
  </h1>
  <p class="ae-subhead" style="margin-top: 16px;">
    Videos, libros, podcasts, guias de carrera, plataformas de donacion y oportunidades de financiamiento.
  </p>
</div>
</section>

 <!-- ========== VIDEOS ========== -->
