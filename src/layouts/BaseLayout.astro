---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';
import '../styles/global.css';
import '../styles/sabana.css';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  currentPage?: string;
  extraHead?: string;
}

const { locale, title, description, currentPage = '' } = Astro.props;
const pageTitle = title || t(locale, 'site.title');
const pageDesc = description || t(locale, 'site.description');
const altLoc = locale === 'es' ? 'en' : 'es';
const currentPath = Astro.url.pathname.replace(`/${locale}`, '');
const altHref = `/${altLoc}${currentPath}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc}>
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={pageDesc}>
  <meta property="og:type" content="website">
  <meta property="og:image" content={`${Astro.site}img/hero.jpg`}>
  <link rel="canonical" href={canonicalUrl.href}>
  <link rel="alternate" hreflang="es" href={`${Astro.site}es${currentPath}`}>
  <link rel="alternate" hreflang="en" href={`${Astro.site}en${currentPath}`}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Source+Serif+4:ital,opsz,wght@1,8..60,400;1,8..60,500&display=swap" rel="stylesheet">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <slot name="head" />
</head>
<body>
  <Navbar locale={locale} currentPage={currentPage} />
  <slot />
  <Footer locale={locale} />
  <script src="../scripts/global.js"></script>
</body>
</html>
